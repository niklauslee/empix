---
import Head from "../components/astro/head.astro";
import Logo from "../components/logo";
import "../styles/global.css";

const GLYPH_W = 16;
const GLYPH_H = 16;
const ASCENT_ROW = 2; // rows above are outside the ascent
const BASELINE_ROW = 13; // baseline sits above this row
const ADVANCE_COL = 13; // advance width ends before this column

// sample bitmap of the currently edited glyph ("A")
const SAMPLE = [
  "................",
  "................",
  ".....####.......",
  "....##..##......",
  "...##....##.....",
  "...##....##.....",
  "..##......##....",
  "..##......##....",
  "..##########....",
  "..##......##....",
  "..##......##....",
  "..##......##....",
  "..##......##....",
  "................",
  "................",
  "................",
];

const tools = [
  { id: "pen", label: "Pen" },
  { id: "eraser", label: "Eraser" },
  { id: "line", label: "Line" },
  { id: "rect", label: "Rect" },
  { id: "fill", label: "Fill" },
  { id: "select", label: "Select" },
];

const shifts = [
  { id: "up", label: "▲" },
  { id: "down", label: "▼" },
  { id: "left", label: "◀" },
  { id: "right", label: "▶" },
];

const ops = [
  { id: "invert", label: "Invert" },
  { id: "flip-h", label: "Flip H" },
  { id: "flip-v", label: "Flip V" },
  { id: "clear", label: "Clear" },
];

const HEX = "0123456789ABCDEF".split("");
const codes = Array.from({ length: 95 }, (_, i) => 32 + i);
const selectedCode = 65; // "A"

const fontMetrics = [
  { label: "Family", value: "Empix Sans" },
  { label: "Pixel Size", value: "16" },
  { label: "Ascent", value: "14" },
  { label: "Descent", value: "3" },
  { label: "Cap Height", value: "11" },
  { label: "X Height", value: "8" },
  { label: "Line Gap", value: "2" },
];

const glyphMetrics = [
  { label: "Codepoint", value: "U+0041" },
  { label: "Name", value: "A" },
  { label: "Width", value: "16" },
  { label: "Height", value: "16" },
  { label: "Advance", value: "13" },
  { label: "Offset X", value: "0" },
  { label: "Offset Y", value: "-3" },
];
---

<html lang="en">
  <Head title="Empix Font Editor" />
  <body class="dark">
    <main
      class="absolute inset-0 flex flex-col bg-background text-foreground select-none"
    >
      <!-- appbar -->
      <header
        class="flex h-12 shrink-0 items-center justify-between border-b-[1.5px] border-neutral-700"
      >
        <div class="flex items-center justify-start px-4">
          <Logo size={1.5} className="text-green-600" />
          <div class="ml-3 text-xl">font</div>
        </div>
        <div class="flex items-center gap-2 px-4 text-xs">
          <button
            class="h-7 border border-neutral-700 px-3 hover:bg-neutral-800"
            >Import BDF</button
          >
          <button
            class="h-7 border border-neutral-700 px-3 hover:bg-neutral-800"
            >Export</button
          >
          <button class="h-7 bg-neutral-100 px-3 text-black"
            >Generate C++</button
          >
        </div>
      </header>

      <section class="flex min-h-0 flex-1">
        <!-- left sidebar: glyph browser -->
        <aside
          class="flex w-56 shrink-0 flex-col border-r-[1.5px] border-neutral-700"
        >
          <div
            class="flex h-8 shrink-0 items-center justify-between border-b border-neutral-800 px-3 text-xs text-muted-foreground"
          >
            <span>Glyphs</span>
            <span>{codes.length}</span>
          </div>
          <div class="shrink-0 border-b border-neutral-800 p-2">
            <input
              type="text"
              placeholder="Search char or U+XXXX"
              class="h-7 w-full border border-neutral-700 bg-transparent px-2 text-xs placeholder:text-neutral-600"
            />
          </div>
          <div class="min-h-0 flex-1 overflow-y-auto p-2">
            <div class="grid grid-cols-6 gap-px">
              {
                codes.map((code) => (
                  <button
                    data-glyph={code}
                    data-active={code === selectedCode}
                    title={`U+${code.toString(16).toUpperCase().padStart(4, "0")}`}
                    class="flex aspect-square items-center justify-center border border-neutral-800 font-mono text-sm hover:bg-neutral-800 data-[active=true]:bg-neutral-100 data-[active=true]:text-black"
                  >
                    {String.fromCharCode(code)}
                  </button>
                ))
              }
            </div>
          </div>
        </aside>

        <!-- center: toolbar + editor + preview -->
        <article class="flex min-w-0 flex-1 flex-col">
          <!-- toolbar -->
          <div
            class="flex h-12 shrink-0 items-center gap-4 border-b-[1.5px] border-neutral-700 px-4 text-xs"
          >
            <div class="flex items-center gap-px">
              {
                tools.map((tool) => (
                  <button
                    data-tool={tool.id}
                    data-active={tool.id === "pen"}
                    class="h-7 border border-neutral-700 px-2 hover:bg-neutral-800 data-[active=true]:bg-neutral-100 data-[active=true]:text-black"
                  >
                    {tool.label}
                  </button>
                ))
              }
            </div>
            <div class="h-6 w-px bg-neutral-700"></div>
            <div class="flex items-center gap-px">
              {
                shifts.map((shift) => (
                  <button
                    data-shift={shift.id}
                    title={`Shift ${shift.id}`}
                    class="h-7 w-7 border border-neutral-700 hover:bg-neutral-800"
                  >
                    {shift.label}
                  </button>
                ))
              }
            </div>
            <div class="h-6 w-px bg-neutral-700"></div>
            <div class="flex items-center gap-px">
              {
                ops.map((op) => (
                  <button
                    data-op={op.id}
                    class="h-7 border border-neutral-700 px-2 hover:bg-neutral-800"
                  >
                    {op.label}
                  </button>
                ))
              }
            </div>
            <div class="ml-auto flex items-center gap-2">
              <label class="flex items-center gap-1 text-muted-foreground">
                <input
                  type="checkbox"
                  checked
                  id="show-guides"
                  class="size-3"
                />
                Guides
              </label>
            </div>
          </div>

          <!-- editing grid -->
          <div
            class="flex min-h-0 flex-1 items-center justify-center overflow-auto p-6"
          >
            <div class="flex flex-col">
              <!-- column ruler -->
              <div class="flex pl-6">
                {
                  HEX.slice(0, GLYPH_W).map((h) => (
                    <div class="w-5.5 text-center font-mono text-[10px] text-neutral-600">
                      {h}
                    </div>
                  ))
                }
              </div>
              <div class="flex">
                <!-- row ruler -->
                <div class="flex w-6 flex-col">
                  {
                    HEX.slice(0, GLYPH_H).map((h) => (
                      <div class="flex h-5.5 items-center justify-end pr-1 font-mono text-[10px] text-neutral-600">
                        {h}
                      </div>
                    ))
                  }
                </div>
                <div class="relative border border-neutral-700">
                  <div class="grid grid-cols-16">
                    {
                      SAMPLE.flatMap((row, y) =>
                        row
                          .split("")
                          .map((cell, x) => (
                            <div
                              data-x={x}
                              data-y={y}
                              data-on={cell === "#" ? "1" : "0"}
                              class={`size-5.5 border border-neutral-900 ${cell === "#" ? "bg-neutral-100" : ""}`}
                            />
                          )),
                      )
                    }
                  </div>
                  <!-- metric guides -->
                  <div id="guides" class="pointer-events-none absolute inset-0">
                    <div
                      class="absolute inset-x-0 border-t border-dashed border-sky-500/60"
                      style={`top: ${ASCENT_ROW * 22}px`}
                    >
                      <span
                        class="absolute -top-4 right-0 font-mono text-[10px] text-sky-500/80"
                        >ascent</span
                      >
                    </div>
                    <div
                      class="absolute inset-x-0 border-t border-dashed border-red-500/70"
                      style={`top: ${BASELINE_ROW * 22}px`}
                    >
                      <span
                        class="absolute -top-4 right-0 font-mono text-[10px] text-red-500/80"
                        >baseline</span
                      >
                    </div>
                    <div
                      class="absolute inset-y-0 border-l border-dashed border-amber-500/70"
                      style={`left: ${ADVANCE_COL * 22}px`}
                    >
                      <span
                        class="absolute -bottom-4 left-1 font-mono text-[10px] text-amber-500/80"
                        >advance</span
                      >
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- preview -->
          <div
            class="flex h-28 shrink-0 flex-col justify-center gap-2 border-t-[1.5px] border-neutral-700 px-6"
          >
            <div class="text-xs text-muted-foreground">Preview</div>
            <div class="font-mono text-sm">
              The quick brown fox jumps over the lazy dog. 0123456789
            </div>
            <div class="font-mono text-xl">Handgloves ABC abc 123</div>
          </div>
        </article>

        <!-- right sidebar: properties -->
        <aside
          class="flex w-56 shrink-0 flex-col overflow-y-auto border-l-[1.5px] border-neutral-700"
        >
          <div
            class="flex h-8 shrink-0 items-center border-b border-neutral-800 px-3 text-xs text-muted-foreground"
          >
            Font
          </div>
          <div class="flex flex-col gap-1 border-b border-neutral-800 p-2">
            {
              fontMetrics.map((metric) => (
                <label class="flex items-center justify-between gap-2 text-xs">
                  <span class="text-muted-foreground">{metric.label}</span>
                  <input
                    type="text"
                    value={metric.value}
                    class="h-6 w-24 border border-neutral-700 bg-transparent px-1 text-right"
                  />
                </label>
              ))
            }
          </div>
          <div
            class="flex h-8 shrink-0 items-center border-b border-neutral-800 px-3 text-xs text-muted-foreground"
          >
            Glyph
          </div>
          <div class="flex flex-col gap-1 p-2">
            {
              glyphMetrics.map((metric) => (
                <label class="flex items-center justify-between gap-2 text-xs">
                  <span class="text-muted-foreground">{metric.label}</span>
                  <input
                    type="text"
                    value={metric.value}
                    class="h-6 w-24 border border-neutral-700 bg-transparent px-1 text-right"
                  />
                </label>
              ))
            }
          </div>
        </aside>
      </section>

      <!-- status bar -->
      <footer
        class="flex h-6 shrink-0 items-center justify-between border-t-[1.5px] border-neutral-700 px-4 font-mono text-[10px] text-muted-foreground"
      >
        <div class="flex gap-4">
          <span>U+0041 "A"</span>
          <span id="status-tool">pen</span>
        </div>
        <div class="flex gap-4">
          <span id="status-pos">-, -</span>
          <span id="status-count">0 px</span>
          <span>{GLYPH_W}x{GLYPH_H}</span>
        </div>
      </footer>
    </main>

    <script>
      const grid = document.querySelector<HTMLElement>(".grid-cols-16")!;
      const cells = Array.from(grid.querySelectorAll<HTMLElement>("[data-x]"));
      const width = 16;
      const height = 16;

      const statusTool = document.getElementById("status-tool")!;
      const statusPos = document.getElementById("status-pos")!;
      const statusCount = document.getElementById("status-count")!;

      let tool = "pen";
      let painting = false;
      let paintOn = true;

      function setCell(cell: HTMLElement, on: boolean) {
        cell.dataset.on = on ? "1" : "0";
        cell.classList.toggle("bg-neutral-100", on);
      }

      function readMatrix() {
        return cells.map((cell) => cell.dataset.on === "1");
      }

      function writeMatrix(matrix: boolean[]) {
        cells.forEach((cell, i) => setCell(cell, matrix[i]));
        updateCount();
      }

      function updateCount() {
        const on = cells.filter((cell) => cell.dataset.on === "1").length;
        statusCount.textContent = `${on} px`;
      }

      // tools
      document
        .querySelectorAll<HTMLElement>("[data-tool]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            tool = button.dataset.tool!;
            statusTool.textContent = tool;
            document
              .querySelectorAll<HTMLElement>("[data-tool]")
              .forEach((other) => {
                other.dataset.active = String(other === button);
              });
          });
        });

      // painting
      cells.forEach((cell) => {
        cell.addEventListener("pointerdown", (event) => {
          event.preventDefault();
          painting = true;
          paintOn = tool === "eraser" ? false : cell.dataset.on !== "1";
          setCell(cell, paintOn);
          updateCount();
        });
        cell.addEventListener("pointerenter", () => {
          statusPos.textContent = `${cell.dataset.x}, ${cell.dataset.y}`;
          if (painting) {
            setCell(cell, paintOn);
            updateCount();
          }
        });
      });
      window.addEventListener("pointerup", () => (painting = false));
      grid.addEventListener("pointerleave", () => {
        statusPos.textContent = "-, -";
      });

      // shift
      document
        .querySelectorAll<HTMLElement>("[data-shift]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const [dx, dy] = {
              up: [0, -1],
              down: [0, 1],
              left: [-1, 0],
              right: [1, 0],
            }[button.dataset.shift!]!;
            const before = readMatrix();
            const after = before.map((_, i) => {
              const x = (i % width) - dx;
              const y = Math.floor(i / width) - dy;
              if (x < 0 || x >= width || y < 0 || y >= height) return false;
              return before[y * width + x];
            });
            writeMatrix(after);
          });
        });

      // operations
      document.querySelectorAll<HTMLElement>("[data-op]").forEach((button) => {
        button.addEventListener("click", () => {
          const before = readMatrix();
          const op = button.dataset.op;
          if (op === "invert") {
            writeMatrix(before.map((on) => !on));
          } else if (op === "clear") {
            writeMatrix(before.map(() => false));
          } else if (op === "flip-h") {
            writeMatrix(
              before.map((_, i) => {
                const x = width - 1 - (i % width);
                const y = Math.floor(i / width);
                return before[y * width + x];
              }),
            );
          } else if (op === "flip-v") {
            writeMatrix(
              before.map((_, i) => {
                const x = i % width;
                const y = height - 1 - Math.floor(i / width);
                return before[y * width + x];
              }),
            );
          }
        });
      });

      // glyph selection
      document
        .querySelectorAll<HTMLElement>("[data-glyph]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            document
              .querySelectorAll<HTMLElement>("[data-glyph]")
              .forEach((other) => {
                other.dataset.active = String(other === button);
              });
          });
        });

      // guides
      const guides = document.getElementById("guides")!;
      const showGuides = document.getElementById(
        "show-guides",
      ) as HTMLInputElement;
      showGuides.addEventListener("change", () => {
        guides.classList.toggle("hidden", !showGuides.checked);
      });

      updateCount();
    </script>
  </body>
</html>
