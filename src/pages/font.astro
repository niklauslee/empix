---
import App from "../apps/font-editor/app";
import Head from "../components/astro/head.astro";
import "../styles/global.css";
import { getDb } from "@/lib/db";
import { font } from "@/lib/db/schema";
import { and, eq } from "drizzle-orm";

const user = Astro.locals.user;
const id = Astro.url.searchParams.get("id");

let initialFont: { id: string; name: string; data: string } | null = null;
if (id) {
  if (!user) return Astro.redirect("/login");
  const [row] = await getDb()
    .select({ id: font.id, name: font.name, data: font.data })
    .from(font)
    .where(and(eq(font.id, id), eq(font.userId, user.id)));
  if (!row) return Astro.redirect("/font");
  initialFont = row;
}
---

<html lang="en">
  <Head title="Empix Font Editor" />
  <body class="dark">
    <App
      client:only="react"
      user={user ? { name: user.name, image: user.image } : null}
      initialFont={initialFont}
    />
  </body>
</html>
